[Unit]
Description=Cantaloupe IIIF Image Server Service
# Never stop retrying
StartLimitIntervalSec=0

[Service]
User=root

# Change this to your workspace
WorkingDirectory=/root

# start.sh execs the JVM, so systemd's MainPID is the JVM itself.
ExecStart=/root/start.sh
SyslogIdentifier=cantaloupe

# The JVM exits with 143 on SIGTERM; treat a normal stop as clean, not failed.
SuccessExitStatus=143

# Restart whenever the JVM exits, including after an out-of-memory exit.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
